# Copy to ~/apps/auto-crm-automation/.env on the Lighthouse server and fill in. Never commit the real file.
TIMEZONE=Asia/Singapore

# Encrypts credentials stored inside n8n. Generate once and keep a backup: openssl rand -hex 32
# Losing it makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=

# The CRM API as seen from the Docker network. Same value as AUTOMATION_API_KEY in auto-crm-api/.env.
AUTO_CRM_API_URL=http://auto-crm-api:8000/api/v1
AUTO_CRM_API_KEY=

# Admin who owns leads from the web form (copy the id from the CRM's Team page)
AUTO_CRM_LEAD_OWNER_ID=

# Who receives the daily digest and deal notifications (comma separated)
NOTIFY_EMAIL_TO=
