{
  "id": "autoCrmLeadScore1",
  "name": "Auto CRM · New lead → AI score → follow-up task",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "b1f0a1e0-0001-4a00-9000-000000000001",
      "name": "contact.created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b1f0a1e0-0001-4a00-9000-0000000000a1",
      "parameters": {
        "httpMethod": "POST",
        "path": "auto-crm/contact-created",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0001-4a00-9000-000000000002",
      "name": "Is a lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.data.status }}",
              "rightValue": "lead",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0001-4a00-9000-000000000003",
      "name": "Score with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTO_CRM_API_URL }}/ai/contacts/{{ $('contact.created').item.json.body.data.id }}/score",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTO_CRM_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b1f0a1e0-0001-4a00-9000-000000000004",
      "name": "Hot lead? (score ≥ 70)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0001-4a00-9000-000000000005",
      "name": "Create follow-up task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTO_CRM_API_URL }}/tasks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTO_CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  title: `Follow up hot lead: ${$('contact.created').item.json.body.data.first_name} ${$('contact.created').item.json.body.data.last_name ?? ''}`.trim(),\n  description: `AI score ${$('Score with AI').item.json.score}/100.\\n\\n${$('Score with AI').item.json.reasoning}`,\n  priority: 'high',\n  due_date: $now.plus({ days: 1 }).toISODate(),\n  contact_id: $('contact.created').item.json.body.data.id,\n  assignee_id: $('contact.created').item.json.body.data.owner_id\n}) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "contact.created": {
      "main": [
        [
          {
            "node": "Is a lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is a lead?": {
      "main": [
        [
          {
            "node": "Score with AI",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Score with AI": {
      "main": [
        [
          {
            "node": "Hot lead? (score ≥ 70)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hot lead? (score ≥ 70)": {
      "main": [
        [
          {
            "node": "Create follow-up task",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}
