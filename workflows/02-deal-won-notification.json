{
  "id": "autoCrmDealWon01",
  "name": "Auto CRM · Deal won → team notification",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "b1f0a1e0-0002-4a00-9000-000000000001",
      "name": "deal.won",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "b1f0a1e0-0002-4a00-9000-0000000000a1",
      "parameters": {
        "httpMethod": "POST",
        "path": "auto-crm/deal-won",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0002-4a00-9000-000000000002",
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForEachItem",
        "jsCode": "// The CRM sends { event, occurred_at, data }, where data is the deal.\nconst deal = $json.body.data;\n\nconst amount = new Intl.NumberFormat('en-US', {\n  style: 'currency',\n  currency: deal.currency || 'USD',\n}).format(deal.value ?? 0);\n\nconst contact = deal.contact\n  ? `${deal.contact.first_name} ${deal.contact.last_name ?? ''}`.trim()\n  : 'n/a';\n\nreturn {\n  json: {\n    subject: `Deal won: ${deal.title} (${amount})`,\n    text: [\n      `Deal: ${deal.title}`,\n      `Value: ${amount}`,\n      `Company: ${deal.company?.name ?? 'n/a'}`,\n      `Contact: ${contact}`,\n      `Owner: ${deal.owner?.full_name ?? 'n/a'}`,\n    ].join('\\n'),\n  },\n};\n"
      }
    },
    {
      "id": "b1f0a1e0-0002-4a00-9000-000000000003",
      "name": "Send email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "The CRM API sends the email: Brevo.",
      "retryOnFail": true,
      "maxTries": 3,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AUTO_CRM_API_URL }}/emails/notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTO_CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { to: $env.NOTIFY_EMAIL_TO.split(',').map((address) => address.trim()), subject: $json.subject, text: $json.text } }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "deal.won": {
      "main": [
        [
          {
            "node": "Build message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build message": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
