{
  "id": "autoCrmDigest001",
  "name": "Auto CRM · Daily overdue tasks digest",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "b1f0a1e0-0003-4a00-9000-000000000001",
      "name": "Every day 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "b1f0a1e0-0003-4a00-9000-000000000002",
      "name": "Get overdue tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AUTO_CRM_API_URL }}/tasks",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "overdue",
              "value": "true"
            },
            {
              "name": "size",
              "value": "100"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AUTO_CRM_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0003-4a00-9000-000000000003",
      "name": "Any overdue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0a1e0-0003-4a00-9000-000000000004",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Group overdue tasks by assignee and build a plain-text digest.\nconst { items: tasks, total } = $input.first().json;\n\nconst byAssignee = {};\nfor (const task of tasks) {\n  const name = task.assignee?.full_name ?? 'Unassigned';\n  (byAssignee[name] ??= []).push(task);\n}\n\nconst sections = Object.entries(byAssignee).map(([name, list]) => {\n  const lines = list.map(\n    (t) => `  • [${t.priority}] ${t.title} due ${new Date(t.due_date).toLocaleDateString()}`,\n  );\n  return `${name} (${list.length})\\n${lines.join('\\n')}`;\n});\n\nreturn [\n  {\n    json: {\n      subject: `Auto CRM: ${total} overdue task(s)`,\n      text: sections.join('\\n\\n'),\n    },\n  },\n];\n"
      }
    },
    {
      "id": "b1f0a1e0-0003-4a00-9000-000000000005",
      "name": "Send digest",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        -100
      ],
      "notes": "Uses the \"Mailpit SMTP\" credential (see credentials/). Swap it for your real SMTP provider in production.",
      "parameters": {
        "fromEmail": "={{ $env.NOTIFY_EMAIL_FROM }}",
        "toEmail": "={{ $env.NOTIFY_EMAIL_TO }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "mailpitSmtpCred1",
          "name": "Mailpit SMTP"
        }
      }
    }
  ],
  "connections": {
    "Every day 08:00": {
      "main": [
        [
          {
            "node": "Get overdue tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get overdue tasks": {
      "main": [
        [
          {
            "node": "Any overdue?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any overdue?": {
      "main": [
        [
          {
            "node": "Build digest",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Build digest": {
      "main": [
        [
          {
            "node": "Send digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
