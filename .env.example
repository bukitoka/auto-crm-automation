# Timezone used by schedule triggers (e.g. the daily digest)
TIMEZONE=Asia/Jakarta

# Encrypts credentials stored inside n8n. Generate once: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# Auto CRM API as seen from inside the n8n container
AUTO_CRM_API_URL=http://host.docker.internal:8000/api/v1
# Must match AUTOMATION_API_KEY in auto-crm-api/.env
AUTO_CRM_API_KEY=change-me

# Admin who owns leads from the web form (copy the id from the CRM's Team page)
AUTO_CRM_LEAD_OWNER_ID=

# Who receives the daily digest and deal notifications (comma separated).
# The CRM API sends them, so the mail settings live in auto-crm-api/.env.
NOTIFY_EMAIL_TO=team@example.com
